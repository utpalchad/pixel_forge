APP_NAME=Pixel Forge API
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://forge-pixel-forge.onrender.com
MAX_UPLOAD_MB=8
OUTPUT_DIR=outputs

# Optional media hosting (required for three.ws image-to-3D uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional vision providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# AI 3D provider
THREEWS_BASE_URL=https://three.ws
THREEWS_DEFAULT_TIER=draft
